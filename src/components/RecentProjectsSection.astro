---
import ButtonLink from "./ButtonLink.astro";
import ProjectCard from "./ProjectCard.astro";
---

<style>
	#recent-projects {
		z-index: 0;

		display: flex;
		flex-direction: column;
		justify-content: center;

		& > h2 {
			font-size: 3rem;
			text-align: center;
			margin-block: 0 2rem;
		}
		& > a {
			display: block;
			margin-inline: auto;
			width: max-content;
		}
	}
	#recent-projects > .project-grid {
		--max-width: 280px;
		--columns: 1;
		--gap: 1.25rem;
		max-width: min(
			100%,
			calc(
				(var(--max-width) * var(--columns)) +
					((var(--columns) - 1) * var(--gap))
			)
		);

		margin-block: 2rem;
		margin-inline: auto;

		display: grid;
		grid-template-columns: repeat(
			var(--columns),
			minmax(min(var(--max-width), 100%), 1fr)
		);

		justify-content: center;
		flex-wrap: wrap;
		gap: 1.25rem;

		.project-card {
			width: 100%;
			max-width: var(--max-width);
		}

		@media (width > 20rem) {
			& {
				--max-width: 300px;
			}
		}

		@media (width > 40rem) {
			& {
				--columns: 2;
			}
			.project-card:last-of-type {
				grid-column: 1 / -1;
				margin-inline: auto;
			}
		}

		@media (width >= 64rem) {
			& {
				--columns: 3;
			}
			.project-card:last-of-type {
				grid-column: unset;
				margin-inline: 0;
			}
		}

		@media (width >= 80rem) {
			& {
				--max-width: 360px;
			}
		}
	}
</style>
<section id="recent-projects" class="min-screen-height">
	<h2 class="section-title">Recent Projects</h2>
	<div class="project-grid">
		<ProjectCard
			title="Campus Online Navigation Tool"
			tag="Web App"
			frontEndTechs={["vue", "typescript"]}
			databaseTechs={["firebase", "supabase"]}
		/>
		<!-- <ProjectCard title="Project 1" tag="Fullstack" /> -->
		<ProjectCard
			title="NuestraRx Platform"
			tag="Multi-Platform"
			frontEndTechs={["vue"]}
			backEndTechs={["php", "vb"]}
			databaseTechs={["mysql"]}
		/>
	</div>
	<ButtonLink theme="primary" size="lg" className="rounded" href="/projects">
		All Projects
	</ButtonLink>
</section>
