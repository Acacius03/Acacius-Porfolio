---
import ButtonLink from "./ButtonLink.astro";
---

<style>
    nav {
        background-color: hsl(0 0 6 / 0.8);
        backdrop-filter: blur(20px);

        position: sticky;
        top: 0;
        inset-inline: 0;
        z-index: 99999;

        display: flex;
        align-items: center;
        flex-wrap: wrap;

        padding: 1rem 1.5rem;
    }

    nav a {
        text-decoration: none;

        &#brand-name {
            margin-right: auto;
            border-radius: calc(infinity * 1px);
            padding: 0.5rem 1.5rem;

            font-size: 1.7rem;
            line-height: 1.2;
            text-transform: uppercase;
        }

        &.nav-links {
            padding: 0.75rem 1rem;
            border-radius: 0.25rem;

            &:hover {
                background-color: hsl(0 0 100 / 0.02);
            }
        }
    }
</style>
<nav>
    <a id="brand-name" class="bg-light translucent" href="/">ACACIUS</a>

    <a class="nav-links" href="/">Home</a>
    <a class="nav-links" href="/about">About</a>
    <a class="nav-links" href="/projects">Projects</a>

    <ButtonLink
        theme="primary"
        id="contact-btn"
        classNames="rounded-lg ml-auto"
    >
        Contact Me!
    </ButtonLink>
</nav>
