---
import { Image } from "astro:assets";
import ButtonLink from "./ButtonLink.astro";
import GitHubIcon from "../assets/icons/github.svg";
import LinkedInIcon from "../assets/icons/linkedin.svg";
---

<style>
    #hero-section {
        padding: 1.25rem;

        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hero-description {
        font-size: 2rem;
        line-height: 1.15;

        margin-bottom: 1.5rem;
    }

    .text-rotator {
        display: inline-block;

        color: var(--color-secondary);

        height: calc(1em * 1.15);
        overflow: hidden;

        & span {
            display: block;
            animation: slide-up 6000ms ease-in-out infinite;
        }
    }

    .social-icon {
        background-color: hsl(0 0 100 / 0.1);
        fill: hsl(0 0 47);

        display: inline-block;

        width: 5rem;
        height: 5rem;

        border-radius: calc(infinity * 1px);
        padding: 0.5rem;

        &:hover {
            background-color: hsl(0 0 100 / 0.2);
            fill: hsl(0 0 94);
        }
    }

    .glow {
        box-shadow: 0px 0px 12px 0px hsl(0 0 67 / 0.05);

        &:hover {
            box-shadow: 0px 0px 12px 0px hsl(0 0 67 / 0.2);
        }
    }

    @keyframes slide-up {
        /* Show 1st */
        0%,
        30% {
            transform: translateY(0);
        }
        /* Slide to 2nd */
        33%,
        63% {
            transform: translateY(-100%);
        }
        /* Slide to 3rd */
        66%,
        97% {
            transform: translateY(-200%);
        }
    }
</style>

<section id="hero-section" class="min-screen-height">
    <div class="my-auto">
        <h1 class="text-7xl sm:text-8xl">Hi! I'm Acacius</h1>

        <p class="hero-description">
            Creating Digital Experiences
            <span class="text-secondary"> Through </span>

            <br />
            <span class="text-rotator">
                <span>Games</span>
                <span>Apps</span>
                <span>Websites</span>
            </span>
        </p>

        <ButtonLink
            theme="primary"
            shape="pill"
            size="lg"
            classNames="glow"
            href="/projects"
        >
            See My Works
        </ButtonLink>
    </div>
    <div>
        <a
            href="https://github.com/Acacius03"
            aria-label="GitHub"
            class="social-icon"
        >
            <GitHubIcon />
        </a>
        <a
            href="https://www.linkedin.com/in/felix-erickson-de-loyola-iii"
            aria-label="LinkedIn"
            class="social-icon"
        >
            <LinkedInIcon />
        </a>
    </div>
</section>
