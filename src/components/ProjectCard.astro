---
import { Image } from "astro:assets";
import TechStackIcons from "./TechStackIcons.astro";
type ProjectTag =
	| "Frontend"
	| "Backend"
	| "Fullstack"
	| "Mobile"
	| "Web App"
	| "Desktop"
	| "Multi-Platform";

type FrontendTech = "javascript" | "typescript" | "react" | "vue";
type BackendTech = "laravel" | "asp" | "python" | "php" | "vb";
type DatabaseTech = "sqlite" | "firebase" | "supabase" | "mysql";

interface Props {
	title: string;
	tag: ProjectTag;
	img?: {
		src: string;
		alt: string;
	};
	frontEndTechs?: FrontendTech[];
	backEndTechs?: BackendTech[];
	databaseTechs?: DatabaseTech[];
}

const {
	title,
	tag,
	img = {
		src: "https://picsum.photos/320/240",
		alt: "Project",
	},
	frontEndTechs = [],
	backEndTechs = [],
	databaseTechs = [],
} = Astro.props;
---

<style>
	.project-card {
		min-width: 240px;
		background-color: hsl(0 0 6);

		display: grid;
		grid-template-rows: auto 1fr;
		border: 1px solid var(--color-neutral-800);

		border-top-left-radius: 1.25rem;
		border-top-right-radius: 1.25rem;
		border-bottom-left-radius: 0.25rem;
		border-bottom-right-radius: 0.25rem;

		transition: transform 180ms ease-out 180ms;
	}

	.project-img-container {
		position: relative;
		overflow: hidden;

		border: 1px solid hsl(0 0 94 / 0.1);
		border-top-left-radius: 0.75rem;
		border-top-right-radius: 0.75rem;
		margin: 0.5rem;

		&::after {
			content: "";
			position: absolute;
			inset: 0;
			background-color: hsl(0 0 6 / 0.15);
		}
	}

	.project-img {
		width: 100%;
		aspect-ratio: 4/3;
		object-fit: cover;
		transition: transform 200ms ease-out;
	}

	.tag {
		position: absolute;
		top: 0;
		right: 0;

		background-color: hsl(0 0 6 / 0.6);
		backdrop-filter: blur(8px);

		border: 1px solid hsl(0 0% 100% / 0.08);

		color: var(--color-white);
		font-size: 0.8rem;
		line-height: 1.15;

		margin: 0.5rem;
		border-radius: calc(infinity * 1px);

		padding: 0.45em 0.85em;
	}

	.project-details {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		justify-content: space-between;

		color: var(--color-white);

		padding: 0.25rem 1rem 1rem;
	}

	.project-title {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		line-height: 1.15;
	}

	.project-card:hover {
		transform: scale(1.01) translateY(-0.5%);
		border-width: 2px;

		.project-img {
			transform: scale(1.02);
		}
	}
</style>
<article class="project-card">
	<div class="project-img-container">
		<Image
			src={img.src}
			alt={img.alt}
			width="320"
			height="240"
			class="project-img"
		/>
		<span class="tag">{tag}</span>
	</div>
	<div class="project-details">
		<h3 class="project-title">{title}</h3>
		<TechStackIcons
			frontEndTechs={frontEndTechs}
			backEndTechs={backEndTechs}
			databaseTechs={databaseTechs}
		/>
	</div>
</article>
