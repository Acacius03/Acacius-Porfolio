---
interface Props {
    title: string;
    tag: string;
    projectSummary: string;
    img?: {
        src: string;
        alt: string;
    };
}

const { title, tag, projectSummary, img } = Astro.props;
---

<style>
    .project-img {
        position: relative;

        & > img {
            border-top-left-radius: 0.25rem;
            border-top-right-radius: 0.25rem;

            object-fit: cover;
        }
    }

    .tag {
        background-color: hsl(0 0 4 / 0.3);
        color: var(--color-white);
        backgdrop-filter: blur(20px);

        line-height: 1;

        position: absolute;
        top: 0;
        right: 0;

        margin: 0.5rem;
        border-radius: calc(infinity * 1px);
        padding: 0.5rem 1rem;
    }

    .project-details {
        border-bottom-left-radius: 0.25rem;
        border-bottom-right-radius: 0.25rem;
        padding: 0.75rem;

        & > h3 {
            font-size: 1.75rem;
        }
    }
</style>
<a href="/">
    <article>
        <div class="project-img">
            <img
                src={img?.src || "https://picsum.photos/320/240"}
                alt={img?.alt || "Project Image"}
                width="320"
                height="240"
            />
            <span class="tag">{tag}</span>
        </div>
        <div class="project-details bg-light translucent">
            <h3>{title}</h3>
            <p>
                {projectSummary}
            </p>
        </div>
    </article>
</a>
