---
interface Props {
    title: string;
    tag: string;
    projectSummary: string;
    img?: {
        src: string;
        alt: string;
    };
}

const { title, tag, projectSummary, img } = Astro.props;
---

<style>
    article {
        position: relative;
        overflow: hidden;

        border: 1px solid hsl(0 0 94 / 0.15);
        padding: 0.5rem;
        border-top-left-radius: 1.25rem;
        border-top-right-radius: 1.25rem;
        border-bottom-left-radius: 0.25rem;
        border-bottom-right-radius: 0.25rem;
        /*border-radius: 1.25rem;*/
        min-width: 240px;
        max-width: 440px;
    }

    .project-img {
        position: relative;
        overflow: hidden;

        border: 1px solid hsl(0 0 94 / 0.3);
        border-top-left-radius: 0.75rem;
        border-top-right-radius: 0.75rem;
    }

    img {
        width: 100%;
        object-fit: cover;
        transition: transform 200ms ease-out;
    }
    .project-img::after {
        content: "";
        position: absolute;
        inset: 0;
        background-color: hsl(0 0 6 / 0.15);
    }
    .tag {
        background-color: hsl(0 0 6 / 0.6);
        color: var(--color-white);
        backgdrop-filter: blur(12px);

        line-height: 1;

        position: absolute;
        top: 0;
        right: 0;

        margin: 1rem;
        border-radius: calc(infinity * 1px);
        padding: 0.5rem 1rem;
    }

    .project-details {
        padding: 0.75rem;

        background-color: transparent;

        color: var(--color-white);

        & > h3 {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            line-height: 1;
        }
    }

    article:hover {
        img {
            transform: scale(1.02);
        }
    }
</style>
<article>
    <div class="project-img">
        <img
            src={img?.src || "https://picsum.photos/320/240"}
            alt={img?.alt || "Project Image"}
            width="320"
            height="240"
        />
    </div>
    <span class="tag">{tag}</span>
    <div class="project-details">
        <h3>{title}</h3>
        <p class="line-clamp-2">
            {projectSummary}
        </p>
    </div>
</article>
