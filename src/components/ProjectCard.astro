---
interface Props {
    title: string;
    tag: string;
    projectSummary: string;
    img?: {
        src: string;
        alt: string;
    };
}

const { title, tag, projectSummary, img } = Astro.props;
---

<style>
    a {
        display: inline-block;
        overflow: hidden;

        border: 1px solid hsl(0 0 94 / 0.15);
        border-radius: 0.25rem;
    }
    .project-img {
        z-index: 0;
        position: relative;
    }
    .project-img > img {
        object-fit: cover;
        transition: transform 200ms ease-out;
    }

    .tag {
        background-color: hsl(271 100 59 / 0.9);
        color: var(--color-white);
        backgdrop-filter: blur(20px);

        line-height: 1;

        position: absolute;
        top: 0;
        right: 0;

        margin: 0.5rem;
        border-radius: calc(infinity * 1px);
        padding: 0.5rem 1rem;
    }

    .project-details {
        position: relative;
        margin-top: -0.25rem;
        border-top: 1px solid hsl(0 0 6 / 0.3);
        padding: 0.75rem;
        background-color: transparent;
        background-image: linear-gradient(
            180deg,
            hsl(0 0 6 / 0.4),
            hsl(0 0 6 / 0.4),
            hsl(0 0 6 / 1),
            hsl(0 0 6 / 1)
        );
        color: var(--color-white);
        backdrop-filter: blur(12px);
        & > h3 {
            font-size: 1.75rem;
            margin-bottom: 0.25rem;
        }
    }

    a:hover {
        .project-img > img {
            transform: scale(1.02);
        }
    }
</style>
<a href="/">
    <article>
        <div class="project-img">
            <img
                src={img?.src || "https://picsum.photos/320/240"}
                alt={img?.alt || "Project Image"}
                width="320"
                height="240"
            />
            <span class="tag">{tag}</span>
        </div>
        <div class="project-details">
            <h3>{title}</h3>
            <p>
                {projectSummary}
            </p>
        </div>
    </article>
</a>
