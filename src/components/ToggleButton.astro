---
interface Props {
	id?: string;
	checked?: boolean;
	theme?: "primary" | "secondary";
	className?: string;
}

const { id, checked = false, theme, className = "" } = Astro.props;
---

<style>
	label.toggle-btn {
		min-height: 3rem;
		font-size: 1rem;
		line-height: 1;

		&.primary {
			background-color: var(--color-primary);
			color: var(--color-white);

			&:hover {
				background-color: var(--color-primary-dim);
			}
			&:active {
				background-color: var(--color-primary-dimmer);
			}
		}

		&.secondary {
			background-color: var(--color-secondary);
			color: var(--color-black);

			&:hover {
				background-color: var(--color-secondary-dim);
			}
			&:active {
				background-color: var(--color-secondary-dimmer);
			}
		}
	}
</style>

<label id={id} class:list={["toggle-btn group", theme, className]}>
	<input type="checkbox" checked={checked} class="peer hidden" />

	<slot />
</label>
