---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<style>
    h1 {
        font-size: 4rem;
    }
    main {
        padding-block: 1.25rem;
        position: relative;

        display: grid;
        grid-template-columns: 1fr 4fr;
        gap: 1.25rem;
    }

    main > section {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    main > aside {
        position: sticky;
        top: 6rem;

        height: max-content;
        padding: 0.5rem;

        border-radius: 0.25rem;
    }

    section > .section-title {
        font-size: 3rem;
    }
</style>
<BaseLayout
    pageTitle="Projects"
    meta={{
        description: "Acacius Portfolio Projects Page",
    }}
>
    <header class="wrapper">
        <h1>My Projects</h1>
    </header>
    <main class="wrapper">
        <aside class="bg-light translucent">
            <h3>Outline</h3>
            <ul>
                <li><a href="#recent-projects"> Recent Projects </a></li>
                <li>
                    <a href="#on-development-projects">
                        Projects On Development
                    </a>
                </li>
            </ul>
        </aside>
        <div>
            <section id="recent-projects">
                <h2 class="section-title">Recent Projects</h2>
                <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem
                    eius possimus mollitia debitis quidem deleniti rerum iusto,
                    temporibus, sequi ab at ullam fugiat repellendus repellat
                    voluptates pariatur quibusdam ea minus?
                </p>
            </section>
            <section id="on-development-projects">
                <h2 class="section-title">Projects On Development</h2>
                <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem
                    eius possimus mollitia debitis quidem deleniti rerum iusto,
                    temporibus, sequi ab at ullam fugiat repellendus repellat
                    voluptates pariatur quibusdam ea minus?
                </p>
            </section>
        </div>
    </main>
</BaseLayout>
