---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
// import {Image} from 'astro:assets'

const meta = {
    description: "Acacius Portfolio Projects Page",
};
---

<style>
    header > h1 {
        font-size: 4rem;
        text-align: center;
    }

    main {
        padding-block: 1.25rem;
        position: relative;

        /*display: grid;*/
        /*grid-template-columns: 1fr 4fr;*/
        /*gap: 1.25rem;*/
    }

    /*main > aside {
        position: sticky;
        top: 6rem;

        height: max-content;
        padding: 0.5rem;

        border-radius: 0.25rem;
    }*/

    main > section {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    section > .section-title {
        font-size: 3rem;
    }

    .h-list {
        overflow-x: clip;

        & > .h-list-scroller {
            display: flex;
            gap: 1.25rem;

            overflow: auto;

            padding-block: 0.625rem;
            padding-inline: 1rem;

            & > * {
                flex-basis: 320px;
                flex-shrink: 0;
            }
        }
    }
</style>
<BaseLayout pageTitle="Projects" meta={meta}>
    <header class="wrapper">
        <h1>My Projects</h1>
    </header>
    <main class="wrapper">
        <!-- <aside class="bg-light translucent">
            <h3>Outline</h3>
            <ul>
                <li><a href="#recent-projects"> Recent Projects </a></li>
                <li>
                    <a href="#on-development-projects">
                        Projects On Development
                    </a>
                </li>
            </ul>
        </aside> -->
        <div>
            <section id="recent-projects">
                <h2 class="section-title">Recent Projects</h2>
            </section>
            <!-- <section id="on-development-projects">
                <h2 class="section-title">Projects On Development</h2>
            </section> -->
        </div>
    </main>
</BaseLayout>
