---
import Head from "../components/Head.astro";

interface Props {
    pageTitle: string;
    meta: {
        description: string;
    };
}

const { pageTitle, meta } = Astro.props;
---

<html lang="en">
    <Head pageTitle={pageTitle} meta={meta} />
    <body class="gradient bg-dark">
        <slot />
        <script>
            const root = document.documentElement;
            const body = document.body;

            let targetX = window.innerWidth / 2;
            let targetY = window.innerHeight / 2;

            let currentX = targetX;
            let currentY = targetY;

            function clamp(min: number, value: number, max: number) {
                return Math.max(min, Math.min(value, max));
            }

            function animate() {
                currentX += (targetX - currentX) * 0.2;
                currentY += (targetY - currentY) * 0.2;

                root.style.setProperty("--mouse-x", currentX + "px");
                root.style.setProperty("--mouse-y", currentY + "px");

                requestAnimationFrame(animate);
            }

            function updateScrollGlow() {
                const scroll = window.scrollY;
                const maxScroll = body.scrollHeight;
                const vh = window.innerHeight;

                const vhCount = maxScroll / vh;

                const progress = maxScroll > 0 ? scroll / maxScroll : 0;

                const size = clamp(
                    50,
                    50 + progress * 85 * vhCount,
                    100 * vhCount * 0.85,
                );

                const fade = 60 + progress * 30;

                root.style.setProperty("--hero-size", `${size}dvw`);
                root.style.setProperty("--hero-fade", `${fade}%`);
            }

            body.addEventListener("mousemove", (e) => {
                targetX = e.pageX;
                targetY = e.pageY;
            });

            window.addEventListener("scroll", updateScrollGlow);
            window.addEventListener("resize", updateScrollGlow);

            animate();
            updateScrollGlow();
        </script>
    </body>
</html>
