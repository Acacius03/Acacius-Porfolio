---
import { Font } from "astro:assets";
import MainNavigation from "../components/MainNavigation.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/Acacius-Porfolio/favicon.svg"
        />
        <link rel="icon" href="/Acacius-Porfolio/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro</title>
        <link rel="stylesheet" href="/Acacius-Porfolio/style.css" />
        <Font cssVariable="--font-Quicksand" />
        <Font cssVariable="--font-Roboto" />
    </head>
    <body class="gradient">
        <MainNavigation />
        <slot />
        <script>
            const root = document.documentElement;

            let targetX = window.innerWidth / 2;
            let targetY = window.innerHeight / 2;

            let currentX = targetX;
            let currentY = targetY;

            document.addEventListener("mousemove", (event) => {
                targetX = event.clientX;
                targetY = event.clientY;
            });

            function animate() {
                currentX += (targetX - currentX) * 0.2;
                currentY += (targetY - currentY) * 0.2;

                root.style.setProperty("--mouse-x", currentX + "px");
                root.style.setProperty("--mouse-y", currentY + "px");

                requestAnimationFrame(animate);
            }

            animate();
        </script>
    </body>
</html>
